; ModuleID = 'claw'
target triple = "x86_64-w64-windows-gnu"

%claw.slice = type { ptr, i64 }
%claw.buffer = type { ptr, i64, i64 }
define internal i32 @"test_backend.lift_outcome::consume"({ i32, [4 x i8] } %arg.source) {
entry:
  %lift.tag.0 = extractvalue { i32, [4 x i8] } %arg.source, 0
  %lift.is_ok.1 = icmp eq i32 %lift.tag.0, 0
  br i1 %lift.is_ok.1, label %entry.lift_ok.0, label %lift_fail_0
entry.lift_ok.0:
  %choice.case.addr.2 = alloca { i32, [4 x i8] }, align 4
  store { i32, [4 x i8] } %arg.source, ptr %choice.case.addr.2, align 4
  %choice.payload.slot.3 = getelementptr inbounds { i32, [4 x i8] }, ptr %choice.case.addr.2, i32 0, i32 1
  %choice.payload.base.4 = getelementptr inbounds [4 x i8], ptr %choice.payload.slot.3, i32 0, i64 0
  %choice.payload.field.ptr.5 = getelementptr inbounds i8, ptr %choice.payload.base.4, i64 0
  %choice.payload.field.6 = load i32, ptr %choice.payload.field.ptr.5, align 4
  %t0 = add i32 %choice.payload.field.6, 1
  ; drop source : Outcome of Int32, Int32
  ret i32 %t0
lift_fail_0:
  %choice.case.addr.7 = alloca { i32, [4 x i8] }, align 4
  store { i32, [4 x i8] } %arg.source, ptr %choice.case.addr.7, align 4
  %choice.payload.slot.8 = getelementptr inbounds { i32, [4 x i8] }, ptr %choice.case.addr.7, i32 0, i32 1
  %choice.payload.base.9 = getelementptr inbounds [4 x i8], ptr %choice.payload.slot.8, i32 0, i64 0
  %choice.payload.field.ptr.10 = getelementptr inbounds i8, ptr %choice.payload.base.9, i64 0
  %choice.payload.field.11 = load i32, ptr %choice.payload.field.ptr.10, align 4
  ; drop source : Outcome of Int32, Int32
  ret i32 %choice.payload.field.11
}

