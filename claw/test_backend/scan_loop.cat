realm test_backend.scan_loop

fn count(limit: Int32) -> Int32 {
    slot i: Int32 = 0
    slot total: Int32 = 0
    loop i < limit {
        i = i + 1
        when i == 2 {
            skip
        }
        when i == 5 {
            stop
        }
        total = total + i
    }
    give total
}

fn sum_until(data: look Span of Int32, limit: Int32) -> Int32 {
    slot sum: Int32 = 0
    scan item over data {
        when item > limit {
            skip
        }
        when item == 99 {
            stop
        }
        sum = sum + item
    }
    give sum
}
