; ModuleID = 'claw'
target triple = "x86_64-w64-windows-gnu"

%claw.slice = type { ptr, i64 }
%claw.buffer = type { ptr, i64, i64 }
define internal i32 @"test_backend.basic_call::add"(i32 %arg.left, i32 %arg.right) {
entry:
  %t0 = add i32 %arg.left, %arg.right
  ret i32 %t0
}

define internal i32 @"test_backend.basic_call::main"() {
entry:
  %t0 = call i32 @"test_backend.basic_call::add"(i32 20, i32 22)
  ret i32 %t0
}

