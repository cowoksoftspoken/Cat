; ModuleID = 'claw'
target triple = "x86_64-w64-windows-gnu"

%claw.slice = type { ptr, i64 }
%claw.buffer = type { ptr, i64, i64 }
%"test_backend.choice_pick::Header" = type { i16, i16 }

%"test_backend.choice_pick::Packet" = type { i32, %"test_backend.choice_pick::Header", %claw.buffer }

%"test_backend.choice_pick::Message" = type { i32, [4 x i8], [40 x i8] }

declare void @"claw.runtime.print.i32"(i32)
declare void @llvm.trap()

define internal i32 @"test_backend.choice_pick::inspect"(ptr %arg.msg.addr) {
entry:
  %load.0 = load %"test_backend.choice_pick::Message", ptr %arg.msg.addr, align 8
  %choice.tag.1 = extractvalue %"test_backend.choice_pick::Message" %load.0, 0
  switch i32 %choice.tag.1, label %entry.defect.pick.0 [
    i32 0, label %pick_ping_0
    i32 1, label %pick_data_1
  ]
pick_ping_0:
  ; drop msg : Message
  ret i32 0
pick_data_1:
  %load.2 = load %"test_backend.choice_pick::Message", ptr %arg.msg.addr, align 8
  %choice.case.addr.3 = alloca %"test_backend.choice_pick::Message", align 8
  store %"test_backend.choice_pick::Message" %load.2, ptr %choice.case.addr.3, align 8
  %choice.payload.slot.4 = getelementptr inbounds %"test_backend.choice_pick::Message", ptr %choice.case.addr.3, i32 0, i32 2
  %choice.payload.base.5 = getelementptr inbounds [40 x i8], ptr %choice.payload.slot.4, i32 0, i64 0
  %choice.payload.field.ptr.6 = getelementptr inbounds i8, ptr %choice.payload.base.5, i64 0
  %choice.payload.field.7 = load %"test_backend.choice_pick::Packet", ptr %choice.payload.field.ptr.6, align 8
  %choice.payload.field.ptr.8 = getelementptr inbounds i8, ptr %choice.payload.base.5, i64 32
  %choice.payload.field.9 = load i32, ptr %choice.payload.field.ptr.8, align 4
  %addr.10 = alloca %"test_backend.choice_pick::Packet", align 8
  store %"test_backend.choice_pick::Packet" %choice.payload.field.7, ptr %addr.10, align 8
  %field.ptr.11 = getelementptr inbounds %"test_backend.choice_pick::Packet", ptr %addr.10, i32 0, i32 0
  %t0 = load i32, ptr %field.ptr.11, align 4
  call void @"claw.runtime.print.i32"(i32 %t0)
  ; drop packet : Packet
  ; drop msg : Message
  ret i32 %choice.payload.field.9
entry.defect.pick.0:
  ; defect unreachable_choice "switch reached no matching case"
  call void @llvm.trap()
  unreachable
}

