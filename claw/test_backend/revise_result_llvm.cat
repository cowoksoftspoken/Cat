choice Result[T, E] {
    Ok(value: T)
    Fail(cause: E)
}

fn step(flag: Bool) -> Result[Int32, Str] {
    if flag {
        return Ok(9)
    }
    return Fail("bad")
}

fn show(flag: Bool) {
    val value = try step(flag) else err {
        println(err)
        return
    }
    println(value)
}

fn main() {
    show(true)
}
