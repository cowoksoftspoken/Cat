; ModuleID = 'claw'
target triple = "x86_64-w64-windows-gnu"

%claw.slice = type { ptr, i64 }
%claw.buffer = type { ptr, i64, i64 }
define internal i32 @"test_backend.scan_loop::count"(i32 %arg.limit) {
entry:
  %i.addr = alloca i32, align 4
  store i32 0, ptr %i.addr, align 4
  %total.addr = alloca i32, align 4
  store i32 0, ptr %total.addr, align 4
  br label %loop_header_0
loop_header_0:
  ; phi %phi0 omitted in initial LLVM lowering
  %load.0 = load i32, ptr %i.addr, align 4
  %t0 = icmp slt i32 %load.0, %arg.limit
  br i1 %t0, label %loop_body_1, label %loop_exit_2
loop_body_1:
  %load.1 = load i32, ptr %i.addr, align 4
  %t1 = add i32 %load.1, 1
  store i32 %t1, ptr %i.addr, align 4
  %load.2 = load i32, ptr %i.addr, align 4
  %t2 = icmp eq i32 %load.2, 2
  br i1 %t2, label %when_then_3, label %when_join_4
when_then_3:
  br label %loop_header_0
when_join_4:
  %load.3 = load i32, ptr %i.addr, align 4
  %t3 = icmp eq i32 %load.3, 5
  br i1 %t3, label %when_then_5, label %when_join_6
when_then_5:
  br label %loop_exit_2
when_join_6:
  %load.4 = load i32, ptr %total.addr, align 4
  %load.5 = load i32, ptr %i.addr, align 4
  %t4 = add i32 %load.4, %load.5
  store i32 %t4, ptr %total.addr, align 4
  br label %loop_header_0
loop_exit_2:
  ; phi %phi1 omitted in initial LLVM lowering
  %load.6 = load i32, ptr %total.addr, align 4
  ret i32 %load.6
}

define internal i32 @"test_backend.scan_loop::sum_until"(%claw.slice %arg.data, i32 %arg.limit) {
entry:
  %item.iter.index.addr.0 = alloca i64, align 8
  store i64 0, ptr %item.iter.index.addr.0, align 8
  %item.iter.item.addr.1 = alloca i32, align 4
  %sum.addr = alloca i32, align 4
  store i32 0, ptr %sum.addr, align 4
  br label %scan_header_0
scan_header_0:
  ; phi %phi0 omitted in initial LLVM lowering
  %text.len.2 = extractvalue %claw.slice %arg.data, 1
  %iter.index.3 = load i64, ptr %item.iter.index.addr.0, align 8
  %iter.has_item.4 = icmp ult i64 %iter.index.3, %text.len.2
  br i1 %iter.has_item.4, label %scan_body_1, label %scan_exit_2
scan_body_1:
  %iter.index.5 = load i64, ptr %item.iter.index.addr.0, align 8
  %text.ptr.6 = extractvalue %claw.slice %arg.data, 0
  %iter.item.ptr.7 = getelementptr inbounds i32, ptr %text.ptr.6, i64 %iter.index.5
  %iter.item.8 = load i32, ptr %iter.item.ptr.7, align 4
  store i32 %iter.item.8, ptr %item.iter.item.addr.1, align 4
  %iter.next.index.9 = add i64 %iter.index.5, 1
  store i64 %iter.next.index.9, ptr %item.iter.index.addr.0, align 8
  %load.10 = load i32, ptr %item.iter.item.addr.1, align 4
  %t0 = icmp sgt i32 %load.10, %arg.limit
  br i1 %t0, label %when_then_3, label %when_join_4
when_then_3:
  br label %scan_header_0
when_join_4:
  %load.11 = load i32, ptr %item.iter.item.addr.1, align 4
  %t1 = icmp eq i32 %load.11, 99
  br i1 %t1, label %when_then_5, label %when_join_6
when_then_5:
  br label %scan_exit_2
when_join_6:
  %load.12 = load i32, ptr %sum.addr, align 4
  %load.13 = load i32, ptr %item.iter.item.addr.1, align 4
  %t2 = add i32 %load.12, %load.13
  store i32 %t2, ptr %sum.addr, align 4
  br label %scan_header_0
scan_exit_2:
  ; phi %phi1 omitted in initial LLVM lowering
  %load.14 = load i32, ptr %sum.addr, align 4
  ret i32 %load.14
}

