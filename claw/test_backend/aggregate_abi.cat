realm test_backend.aggregate_abi

share shape Header {
    major: UInt16
    minor: UInt16
}

share shape Packet {
    seq: UInt32
    header: Header
    payload: Bytes
}

fn echo(packet: Packet) -> Packet {
    give packet
}

fn next_seq(packet: Packet) -> UInt32 {
    hold copy: Packet = echo(packet)
    give copy.seq
}

fn patch(header: edit Header, value: UInt16) -> UInt16 {
    header.major = value
    give header.major
}
