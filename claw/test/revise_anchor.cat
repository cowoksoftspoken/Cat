choice StableText {
    Some(value: Anchor[Str])
    None
}

fn show(stable: Anchor[Str], item: StableText) {
    println(stable.get())
    pick item {
        Some(value) {
            println(value.get())
        }
        None {
            println("none")
        }
    }
}

fn main() {
    val stable = Anchor.new("hello")
    val item: StableText = Some(Anchor.new("world"))
    show(stable, item)
}
