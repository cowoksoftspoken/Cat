realm test.definite_init

fn consume_text(text: Text) {
}

fn assign_before_read() {
    slot message: Text
    message = "hello"
    println(message)
}

fn move_then_reinitialize() {
    slot message: Text = "hello"
    consume_text(message)
    message = "again"
    println(message)
}

fn branch_definite_assignment() {
    slot message: Text
    when 1 == 1 {
        message = "yes"
    } otherwise {
        message = "no"
    }
    println(message)
}
