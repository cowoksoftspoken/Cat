realm test.method_dispatch_diagnostics

fn bad_receiver(value: Int32) -> USize {
    give value.len()
}

fn bad_arg(text: look Text) -> Byte {
    give text.byte_at(1.5)
}

fn bad_slice_arg(text: look Text) -> look Text {
    give text.slice(0.5, 1)
}

fn bad_find_arg(text: look Text) -> ISize {
    give text.find_byte(1.5)
}

fn bad_capacity_arg(bytes: look Bytes) -> Bool {
    give bytes.has_capacity(1.5)
}

fn bad_clear_receiver(bytes: look Bytes) {
    bytes.clear()
}

fn bad_reserve_receiver(bytes: look Bytes) {
    bytes.reserve(8)
}

fn bad_truncate_arg(bytes: edit Bytes) {
    bytes.truncate(1.5)
}

fn bad_shrink_receiver(items: look Vec) {
    items.shrink_to_fit()
}
