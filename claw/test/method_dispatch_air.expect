air.realm test.method_dispatch_air
air.fn inspect(text: look Text) -> USize
  hold size: USize = text.len() : USize
  hold prefix: look Text = text.slice(0 : USize, 2 : USize) : look Text
  hold count: USize = text.count_byte(108 : Byte) : USize
  expr print(text.byte_at(0 : USize) : Byte) : Unit
  expr print(text.contains("cl" : Text) : Bool) : Unit
  expr print(text.find_byte(119 : Byte) : ISize) : Unit
  give (size + count) : USize
air.fn tune_bytes(bytes: edit Bytes) -> Unit
  when bytes.has_capacity(8 : USize) : Bool
    expr bytes.truncate(8 : USize) : Unit
  expr bytes.reserve(64 : USize) : Unit
  expr bytes.shrink_to_fit() : Unit
  expr bytes.clear() : Unit
