oir.realm test.drop_schedule
oir.fn schedule_drop(flag: Int32) -> Int32
  block entry:
    slot message: Text = "hello"
    %t0 = eq flag, 0 : Bool
    branch %t0 -> when_then_0, when_join_1
  block when_then_0:
    hold inner: Text = "warmup"
    call println(inner) : Unit
    drop inner : Text
    goto when_join_1
  block when_join_1:
    drop message : Text
    store message <- "again" : Text
    goto loop_header_2
  block loop_header_2:
    %t1 = gt flag, 0 : Bool
    branch %t1 -> loop_body_3, loop_exit_4
  block loop_body_3:
    hold loop_note: Text = "loop"
    drop loop_note : Text
    stop -> loop_exit_4
  block loop_exit_4:
    drop message : Text
    return flag : Int32
