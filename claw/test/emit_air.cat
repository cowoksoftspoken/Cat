realm test.air

shape Config of T {
    share host: Text
    share payload: T
}

choice Maybe of T {
    none
    some(value: T)
}

fn classify(cfg: look Config of Int32, item: Maybe of Int32) -> Int32 {
    print(cfg.host)
    print(cfg.payload)
    pick item {
        none {
            println("empty")
            give 0
        }
        some(value) {
            give value
        }
    }
}
