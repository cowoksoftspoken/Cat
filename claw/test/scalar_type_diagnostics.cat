realm test.scalar_type_diagnostics

fn take_u16(value: UInt16) -> UInt16 {
    give value
}

fn fail_widen(value: UInt32) -> UInt16 {
    give take_u16(value)
}

fn fail_assign(value: UInt64) {
    hold small: UInt16 = value
}

fn fail_binary(left: UInt64, right: USize) -> UInt64 {
    give left + right
}

fn fail_float_mix(value: Float32) -> Float32 {
    give value + 1
}
