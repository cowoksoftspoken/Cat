lir.program entry test.drop_schedule
lir.realm test.drop_schedule
lir.fn schedule_drop(flag: Int32) -> Int32
  block entry:
    alloc stack slot message : Text
    store message <- "hello" : Text
    %t0 = eq flag, 0 : Bool
    branch %t0 -> when_then_0, when_join_1
  block when_then_0 [preds: entry]:
    alloc stack hold inner : Text
    store inner <- "warmup" : Text
    call.runtime println(inner) : Unit hook runtime.println [proven-safe]
    drop inner : Text
    goto when_join_1
  block when_join_1 [preds: entry, when_then_0]:
    %phi0 = phi Control [entry: ctrl.entry, when_then_0: ctrl.when_then_0]
    drop message : Text
    store message <- "again" : Text
    goto loop_header_2
  block loop_header_2 [preds: when_join_1]:
    %t1 = gt flag, 0 : Bool
    branch %t1 -> loop_body_3, loop_exit_4
  block loop_body_3 [preds: loop_header_2]:
    alloc stack hold loop_note : Text
    store loop_note <- "loop" : Text
    drop loop_note : Text
    break -> loop_exit_4
  block loop_exit_4 [preds: loop_header_2, loop_body_3]:
    %phi1 = phi Control [loop_header_2: ctrl.loop_header_2, loop_body_3: ctrl.loop_body_3]
    drop message : Text
    return flag : Int32
