realm main

import term.{emit}
import src.{util, runtime}
import src.api.{Config, Signal, add}

fn inspect(cfg: Config) -> Int32 {
    give cfg.port
}

fn unwrap(signal: Signal) -> Int32 {
    pick signal {
        ready {
            give 0
        }
        failed(code) {
            give code
        }
    }
}

fn main() -> Int32 {
    emit("boot")
    runtime.banner()
    give add(util.answer(), 1)
}
