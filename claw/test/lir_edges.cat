realm test.lir_edges

choice Outcome of T, E {
    ok(value: T)
    fail(cause: E)
}

fn process(source: Outcome of Int32, Text, text: look Text, data: look Span of Int32) -> Int32 {
    hold prefix: look Text = text.slice(0, 2)
    print(prefix)
    print(text.byte_at(0))

    slot sum: Int32 = 0
    scan item over data {
        sum = sum + item
    }

    lift source as value fail issue {
        println(issue)
        give 0
    }

    give sum + value
}
