realm test.method_dispatch_air

fn inspect(text: look Text) -> USize {
    hold size = text.len()
    hold prefix: look Text = text.slice(0, 2)
    hold count = text.count_byte(108)
    print(text.byte_at(0))
    print(text.contains("cl"))
    print(text.find_byte(119))
    give size + count
}

fn tune_bytes(bytes: edit Bytes) {
    when bytes.has_capacity(8) {
        bytes.truncate(8)
    }
    bytes.reserve(64)
    bytes.shrink_to_fit()
    bytes.clear()
}
