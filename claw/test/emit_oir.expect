oir.realm test.air
oir.shape Config of T [abi=claw link=internal symbol=test.air::Config ffi=false]
  layout repr=claw-internal kind=template size=0 align=1 pass=indirect ffi=false unresolved=true
  field host: Text
  field payload: T
oir.choice Maybe of T [abi=claw link=internal symbol=test.air::Maybe ffi=false]
  layout repr=claw-internal kind=template size=0 align=4 pass=indirect ffi=false unresolved=true
  case none
  case some(T)
oir.fn classify(cfg: look Config of Int32 [borrow], item: Maybe of Int32 [direct]) -> Int32 [scalar] [abi=claw link=internal symbol=test.air::classify ffi=false]
  block entry:
    %t0 = field cfg.host : look Text
    call print(%t0) : Unit
    %t1 = field cfg.payload : Int32
    call print(%t1) : Unit
    pick item : Maybe of Int32
    case none -> pick_none_0
    case some(value) -> pick_some_1
  block pick_none_0:
    call println("empty") : Unit
    drop item : Maybe of Int32
    return 0 : Int32
  block pick_some_1:
    drop item : Maybe of Int32
    return value : Int32
