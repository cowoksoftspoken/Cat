realm test.definite_init_diagnostics

fn consume_text(text: Text) {
}

fn read_before_init() {
    slot message: Text
    println(message)
}

fn maybe_uninitialized_after_when() {
    slot message: Text
    when 1 == 1 {
        message = "hello"
    }
    println(message)
}

fn maybe_uninitialized_after_move_branch() {
    slot message: Text = "hello"
    when 1 == 1 {
        consume_text(message)
    }
    println(message)
}
