realm test.method_dispatch

fn inspect_text(text: look Text) -> USize {
    when text.is_empty() {
        println("empty")
        give 0
    }
    print(text.first_byte())
    print(text.last_byte())
    print(text.byte_at(0))
    print(text.find_byte(97))
    print(text.count_byte(97))
    when text.starts_with("cl") {
        print(text.contains("aw"))
    }
    when text.ends_with("aw") {
        print(text.contains_byte(119))
    }
    give text.len()
}

fn inspect_bytes(bytes: look Bytes) -> Byte {
    when bytes.starts_with(bytes.slice(0, 1)) {
        print(bytes.contains_byte(0))
        print(bytes.find_byte(0))
        print(bytes.count_byte(0))
    }
    give bytes.byte_at(0)
}

fn prefix_view(text: look Text) -> look Text {
    give text.slice(0, 2)
}

fn clear_bytes(bytes: edit Bytes) {
    bytes.reserve(64)
    when bytes.has_capacity(8) {
        bytes.truncate(8)
    }
    bytes.shrink_to_fit()
    bytes.clear()
}

fn clear_vec(items: edit Vec of Int32) -> USize {
    items.reserve(32)
    when items.has_capacity(4) {
        items.truncate(4)
    }
    items.shrink_to_fit()
    items.clear()
    give items.capacity()
}

fn tune_table(table: edit Table of Text, Int32) {
    table.reserve(16)
    table.shrink_to_fit()
    table.clear()
}

fn tune_set(items: edit Set of Int32) -> Bool {
    items.reserve(8)
    items.shrink_to_fit()
    give items.has_capacity(4)
}

fn tune_ring(items: edit Ring of Int32) -> USize {
    items.reserve(12)
    items.truncate(6)
    items.shrink_to_fit()
    give items.capacity()
}

fn owned_receiver() -> USize {
    hold text: Text = "claw"
    give text.len()
}
