realm test.scalar_types

fn take_u16(value: UInt16) -> UInt16 {
    give value
}

fn default_infer() -> Int32 {
    slot value = 1
    give value + 2
}

fn keep_byte() -> Byte {
    hold value: Byte = 1
    give value
}

fn add_u64(base: UInt64) -> UInt64 {
    slot total: UInt64 = base + 1
    total = total + 2
    give total
}

fn add_bits(mask: Bits32) -> Bits32 {
    give mask + 1
}

fn compare_usize(count: USize) -> Bool {
    give count == 0
}

fn call_with_literal() -> UInt16 {
    give take_u16(1)
}

fn chain_byte_ops(left: Byte) -> Byte {
    give left + 1
}

fn add_float(left: Float32, right: Float32) -> Float32 {
    give left + right
}
