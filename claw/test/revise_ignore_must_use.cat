choice Maybe[T] {
    None
    Some(value: T)
}

choice Result[T, E] {
    Ok(value: T)
    Fail(cause: E)
}

fn pick_num(flag: Bool) -> Maybe[Int32] {
    if flag {
        return Some(7)
    }
    return None
}

fn step(flag: Bool) -> Result[Int32, Str] {
    if flag {
        return Ok(7)
    }
    return Fail("bad")
}

fn main() {
    val _ = pick_num(true)
    val ignored_result = step(true)
}
